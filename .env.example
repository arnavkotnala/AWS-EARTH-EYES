# Local development settings
PORT=8080
NODE_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPEN_METEO_TIMEOUT_MS=10000
ENABLE_LIVE_WEATHER_SYNC=true
DEFAULT_BASIN=ganga
CACHE_TTL_SECONDS=3600

# Forest Eyes: Global Forest Watch key (globalforestwatch.org -> API keys)
GFW_API_KEY=

# Gemma 4 (shared AI client, gemma.js)
GEMMA_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite
# Amazon Bedrock (Gemma 4) — tried first when both are set.
# Console > Bedrock > API keys (create a key); Model catalog > Gemma 4 26B-A4B > copy the model ID
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=
